{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // Проверки exports и types активны: baseline из LINT_BASELINE.md п.3 разгребён
  // (2026-08-27). duplicates выключена ради единственной находки-не-дефекта:
  // msgpackSerializer = DEFAULT_SERIALIZER в engine/net-ts/src/protocol/codec.ts —
  // одно значение под двумя именами, используются оба (см. LINT_BASELINE.md).
  // Проверки files, dependencies, unlisted, unresolved — активны.
  "rules": {
    "duplicates": "off"
  },
  "ignore": [
    // baseline: рукописные типы к scripts/spec-graph.mjs — импортируются только
    // редакторными LSP, из кода не референсятся.
    "scripts/spec-graph.d.mts",
    // Типы к бинам запускалок: подтягиваются резолвом `../bin/trace.mjs` и
    // `../bin/matchFile.mjs` из тестов слоя запускалок, то есть графом модулей
    // knip не видны — файл объявлений импортом не является. Тот же случай, что
    // строкой выше.
    "engine/net-ts/bin/trace.d.mts",
    "engine/net-ts/bin/matchFile.d.mts"
  ],
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/*.mjs", "engine/tests/guard/*.ts", "engine/tests/bench/*.ts"],
      "project": ["scripts/**", "engine/tests/guard/**", "engine/tests/bench/**", "*.ts", "*.js"]
    },
    "engine/core-ts": {
      "entry": ["bin/*.mjs", "test/**/*.test.ts"]
    },
    "engine/net-ts": {
      "entry": ["bin/*.mjs", "test/**/*.test.ts"]
    },
    "engine/render-ts": {
      "entry": ["test/**/*.test.ts"]
    },
    "engine/assets-ts": {
      "entry": ["test/**/*.test.ts"]
    },
    "engine/client-ts": {
      "entry": ["test/**/*.test.ts"]
    },
    "engine/hud-ts": {
      "entry": ["test/**/*.test.ts"]
    },
    "engine/bot-ts": {
      "entry": ["src/worker/*.ts", "test/**/*.test.ts"]
    },
    "engine/integration-ts": {
      "entry": ["test/**/*.test.ts"],
      "project": ["test/**"]
    },
    "editor/core-ts": {
      "entry": ["test/**/*.test.ts"]
    },
    "editor/ui-ts": {
      "entry": ["app/**/*.ts", "test/**/*.test.ts"]
    },
    "game/demo-ts": {
      "entry": ["app/**/*.ts", "bin/*.mjs", "test/**/*.test.ts"],
      // cloudflared — бинарь ХОСТА, а не зависимость npm: quick-туннель игры
      // вдвоём (`app/tunnel.ts`) спавнит его с PATH, отсутствие — названная
      // подсказка установки, и гейт без него зелёный (спавн тестами не
      // покрывается тем же принципом, что BLND-7 у Blender).
      "ignoreBinaries": ["cloudflared"]
    },
    "game/server-agent-ts": {
      // Фикстуры тестов агента — СКРИПТЫ ПРОЦЕССОВ: агент спавнит их путём, а
      // не импортирует, и графом модулей они не видны. Тот же случай, что у
      // фикстур сервисов десктоп-контейнера.
      "entry": ["bin/*.mjs", "test/**/*.test.ts", "test/fixtures/*.mjs"]
    },
    "game/server-manager-ts": {
      "entry": ["app/**/*.ts", "test/**/*.test.ts", "test/fixtures/*.mjs"]
    },
    "tools/blender-ts": {
      "entry": ["bin/*.mjs", "test/**/*.test.ts", "test/fixtures/build.mjs"]
    },
    "desktop/shell-ts": {
      // entry контейнера — electron-точки (`entry.mjs` зовёт Electron, тот
      // грузит `preload.cjs` по пути-строке) и конфиг упаковщика, который
      // `bin/pack.mjs` тоже передаёт строкой (`--config`).
      "entry": [
        "bin/*.mjs",
        "src/electron/entry.mjs",
        "src/electron/preload.cjs",
        "electron-builder.cjs",
        "test/**/*.test.ts",
        "test/electron/**/*"
      ],
      "project": ["src/**", "bin/**", "test/**", "*.cjs"],
      // упаковщик зовётся не импортом, а `createRequire(...).resolve(...)` в
      // `bin/pack.mjs` — граф модулей такой связи не видит.
      "ignoreDependencies": ["electron-builder"]
    }
  }
}
