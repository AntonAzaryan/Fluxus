node_modules/
dist/
# Бандл приложения для десктоп-контейнера: та же сборка без копии дерева
# контента (`desktop-shell` DSK-4) — артефакт, как и dist/.
dist-desktop/
# Разложенный каталог дистрибутива контейнера (`bin/pack.mjs`): бандл, дерево
# контента и профиль, скопированные внутрь. Артефакт упаковки.
desktop/shell-ts/build/
coverage/
# Артефакты отладочного прогона матча (`npm run demo:debug`, cli-testing CLI-11):
# трейс, запись матча, журнал боя и сводка. Свежий разбор боя — не история
# репозитория, и путь у него намеренно стабильный (`runs/latest`), а не с
# временем в имени.
#
# Правило якорится КОРНЕМ: без ведущего слэша glob совпадал бы с любым `runs/`
# на любой глубине — например с каталогом фикстур или исходников пакета,
# который однажды так назовут, — и файлы пропали бы из индекса молча.
/runs/
*.log
*.tsbuildinfo
*.DS_Store
.idea/

# Правил `src/**/*.js` и `src/**/*.d.ts` здесь намеренно нет. Они писались под
# emit рядом с исходником, которого не бывает: во всех восьми пакетах
# `noEmit: true`, tsc в `src/` ничего не кладёт. Зато глоб молча съедал бы
# настоящий `.js`, если он там понадобится, — а `.mjs`-бины лежат в `bin/`
# ровно потому, что когда-то съедал.
__pycache__/
