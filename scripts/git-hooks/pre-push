#!/usr/bin/env bash
# Клиентский pre-push — гейт репозитория вместо CI (раннеров нет, CLAUDE.md):
# пуш в main не уходит, пока npm run check не зелёный. Фичевые ветки не гейтим —
# полный check на каждый пуш ветки слишком дорог, а в main без него не попасть.
# Включение: git config core.hooksPath scripts/git-hooks — агентские окружения
# делают это в .claude/hooks/session-start.sh, локально — та же команда руками.
# Осознанный обход для человека: git push --no-verify (агенту guard-bash.mjs
# отдаёт такой пуш на подтверждение).
set -euo pipefail

ZERO=0000000000000000000000000000000000000000
push_main=0
# stdin: по строке на ref — "<local ref> <local sha> <remote ref> <remote sha>".
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$local_sha" = "$ZERO" ]; then
    continue # удаление ветки — проверять нечего
  fi
  if [ "$remote_ref" = "refs/heads/main" ]; then
    push_main=1
  fi
done

if [ "$push_main" -ne 1 ]; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
echo "pre-push: пуш в main — прогон полного гейта (npm run check)…" >&2
if ! (cd "$repo_root" && npm run check); then
  echo "" >&2
  echo "pre-push: npm run check красный — пуш в main отклонён." >&2
  echo "Почини и повтори пуш. Осознанный обход человеком: git push --no-verify." >&2
  exit 1
fi
