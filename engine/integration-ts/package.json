{
  "name": "@fluxus/integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "record": "UPDATE_MATCHES=1 vitest run test/matchGolden.test.ts",
    "golden:cost": "UPDATE_COST=1 vitest run test/cost.test.ts"
  },
  "engines": {
    "node": ">=22.18 <23 || ^24 || >=26"
  },
  "dependencies": {
    "@fluxus/assets": "*",
    "@fluxus/core": "*",
    "@fluxus/net": "*",
    "@fluxus/render": "*",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
