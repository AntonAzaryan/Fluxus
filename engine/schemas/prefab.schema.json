{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxus.local/schemas/prefab.schema.json",
  "title": "Prefab (ECS-4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "components"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
