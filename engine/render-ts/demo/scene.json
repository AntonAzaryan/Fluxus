  "systems": [
    {
      "name": "Movement",
      "order": 10,
      "query": { "all": ["Velocity", "Input"], "not": ["Dead"] },
      "as": "e",
      "do": [
        {
          "modifyComponent": {
            "entity": { "var": "e" },
            "component": "Velocity",
            "values": {
              "x": { "*": [{ "getComponent": [{ "var": "e" }, "Input", "moveX"] }, 5243] },
              "y": { "*": [{ "getComponent": [{ "var": "e" }, "Input", "moveY"] }, 5243] }
            }
          }
        }
      ]
    },
    {
      "name": "KillSwitch",
      "order": 20,
      "query": { "all": ["Player", "Input", "Velocity"], "not": ["Dead"] },
      "as": "e",
      "do": [
        {
          "if": {
            "cond": {
              "and": [
                { "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "buttons"] }, 1] },
                { "!": [{ "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "prevButtons"] }, 1] }] }
              ]
            },
            "then": [
              {
                "addComponent": {
                  "entity": { "var": "e" },
                  "component": "Dead",
                  "values": { "atTick": { "tick": [] } }
                }
              },
              {
                "modifyComponent": {
                  "entity": { "var": "e" },
                  "component": "Velocity",
                  "values": { "x": 0, "y": 0 }
                }
              },
              {
                "emitEvent": {
                  "type": "EntityDied",
                  "data": { "entity": { "var": "e" } }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FireballFlight",
      "order": 40,
      "query": { "all": ["Position", "Velocity", "Lifetime"] },
      "as": "e",
      "do": [
        {
          "modifyComponent": {
            "entity": { "var": "e" },
            "component": "Position",
            "values": {
              "x": {
                "+": [
                  { "getComponent": [{ "var": "e" }, "Position", "x"] },
                  { "getComponent": [{ "var": "e" }, "Velocity", "x"] }
                ]
              },
              "y": {
                "+": [
                  { "getComponent": [{ "var": "e" }, "Position", "y"] },
                  { "getComponent": [{ "var": "e" }, "Velocity", "y"] }
                ]
              }
            }
          }
        },
        {
          "modifyComponent": {
            "entity": { "var": "e" },
            "component": "Lifetime",
            "values": {
              "ticks": { "-": [{ "getComponent": [{ "var": "e" }, "Lifetime", "ticks"] }, 1] }
            }
          }
        }
      ]
    }
  ],
