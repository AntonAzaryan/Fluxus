                      {
                        "modifyComponent": {
                          "entity": { "var": "target" },
                          "component": "Mark",
                          "values": { "rank": { "var": "rank" } }
                        }
                      },
                      {
                        "emitEvent": {
                          "type": "Picked",
                          "data": { "rank": { "var": "rank" }, "target": { "var": "target" } }
