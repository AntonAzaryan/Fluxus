{
  "name": "@game-mvp/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts",
    "./portTransport": "./src/portTransport.ts"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:build:desktop": "vite build --config demo/vite.desktop.config.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@game-mvp/assets": "*",
    "@game-mvp/core": "*",
    "@game-mvp/net": "*",
    "@game-mvp/render": "*",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@game-mvp/bot": "*",
    "@game-mvp/hud": "*",
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
