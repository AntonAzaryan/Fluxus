                  "do": [
                    {
                      "forEach": {
                        "query": {
                          "all": ["Owner", "Position", "Velocity", "Lifetime"],
                          "not": ["Held"],
                          "withTag": "Fireball",
                          "withinRadius": { "center": { "var": "at" }, "radius": { "var": "reach" } }
