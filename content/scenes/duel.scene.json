                                  },
                                  {
                                    ">=": [
                                      {
                                        "vec.dot": [
                                          {
                                            "vec.normalize": [
                                              {
                                                "vec.sub": [
                                                  {
                                                    "vec": [
                                                      { "getComponent": [{ "var": "p" }, "Position", "x"] },
                                                      { "getComponent": [{ "var": "p" }, "Position", "y"] }
