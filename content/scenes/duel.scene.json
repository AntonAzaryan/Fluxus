{
  "components": [
    { "name": "Player", "fields": { "slot": "i32" } },
    {
      "name": "Input",
      "fields": {
        "aimDir": "fixed",
        "buttons": "i32",
        "moveX": "fixed",
        "moveY": "fixed",
        "prevButtons": "i32",
        "seq": "i32"
      }
    },
    { "name": "Position", "fields": { "x": "fixed", "y": "fixed" } },
    { "name": "Velocity", "fields": { "x": "fixed", "y": "fixed" } },
    {
      "name": "Collider",
      "fields": { "halfX": "fixed", "halfY": "fixed", "radius": "fixed", "shape": "i32" }
    },
    { "name": "Lifetime", "fields": { "ticks": "i32" } },
    { "name": "Dead", "fields": { "atTick": "i32" } },
    { "name": "Falling", "fields": { "progress": "i32", "duration": "i32" } }
  ],
  "prefabs": [
    {
      "name": "Hero",
      "components": {
        "Player": { "slot": 0 },
        "Input": { "aimDir": 0, "buttons": 0, "moveX": 0, "moveY": 0, "prevButtons": 0, "seq": 0 },
        "Position": { "x": 753664, "y": 753664 },
        "Velocity": { "x": 0, "y": 0 },
        "Collider": { "halfX": 19661, "halfY": 19661, "radius": 19661, "shape": 0 },
        "ArenaState": { "support": 0 }
      },
      "tags": ["Hero"]
    },
    {
      "name": "Fireball",
      "components": {
        "Position": { "x": 0, "y": 0 },
        "Velocity": { "x": 0, "y": 0 },
        "Lifetime": { "ticks": 50 }
      },
      "tags": ["Fireball"]
    }
  ],
  "systems": [
    {
      "name": "Movement",
      "order": 10,
      "query": { "all": ["Velocity", "Input"], "not": ["Dead", "Falling"] },
      "as": "e",
      "do": [
        {
          "modifyComponent": {
            "entity": { "var": "e" },
            "component": "Velocity",
            "values": {
              "x": { "*": [{ "getComponent": [{ "var": "e" }, "Input", "moveX"] }, 5243] },
              "y": { "*": [{ "getComponent": [{ "var": "e" }, "Input", "moveY"] }, 5243] }
            }
          }
        }
      ]
    },
    {
      "name": "KillSwitch",
      "order": 20,
      "query": { "all": ["Player", "Input", "Velocity"], "not": ["Dead", "Falling"] },
      "as": "e",
      "do": [
        {
          "if": {
            "cond": {
              "and": [
                { "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "buttons"] }, 1] },
                { "!": [{ "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "prevButtons"] }, 1] }] }
              ]
            },
            "then": [
              {
                "addComponent": {
                  "entity": { "var": "e" },
                  "component": "Dead",
                  "values": { "atTick": { "tick": [] } }
                }
              },
              {
                "modifyComponent": {
                  "entity": { "var": "e" },
                  "component": "Velocity",
                  "values": { "x": 0, "y": 0 }
                }
              },
              {
                "emitEvent": {
                  "type": "EntityDied",
                  "data": { "entity": { "var": "e" } }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Cast",
      "order": 30,
      "query": { "all": ["Input", "Player"], "not": ["Dead", "Falling"] },
      "as": "e",
      "do": [
        {
          "if": {
            "cond": {
              "and": [
                { "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "buttons"] }, 0] },
                { "!": [{ "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "prevButtons"] }, 0] }] }
              ]
            },
            "then": [
              {
                "let": {
                  "bindings": {
                    "dir": {
                      "vec": [
                        { "cos": [{ "getComponent": [{ "var": "e" }, "Input", "aimDir"] }] },
                        { "sin": [{ "getComponent": [{ "var": "e" }, "Input", "aimDir"] }] }
                      ]
                    }
                  },
                  "do": [
                    {
                      "spawnEntity": {
                        "prefab": "Fireball",
                        "overrides": {
                          "Position": {
                            "x": {
                              "+": [
                                { "getComponent": [{ "var": "e" }, "Position", "x"] },
                                { "*": [{ "vec.x": [{ "var": "dir" }] }, 29491] }
                              ]
                            },
                            "y": {
                              "+": [
                                { "getComponent": [{ "var": "e" }, "Position", "y"] },
                                { "*": [{ "vec.y": [{ "var": "dir" }] }, 29491] }
                              ]
                            }
                          },
                          "Velocity": {
                            "x": { "*": [{ "vec.x": [{ "var": "dir" }] }, 16384] },
                            "y": { "*": [{ "vec.y": [{ "var": "dir" }] }, 16384] }
                          }
                        }
                      }
                    },
                    {
                      "emitEvent": {
                        "type": "CastFireball",
                        "data": {
                          "dirX": { "vec.x": [{ "var": "dir" }] },
                          "dirY": { "vec.y": [{ "var": "dir" }] },
                          "entity": { "var": "e" },
                          "slot": { "getComponent": [{ "var": "e" }, "Player", "slot"] },
                          "tick": { "tick": [] }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FireballFlight",
      "order": 40,
      "query": { "all": ["Position", "Velocity", "Lifetime"] },
      "as": "e",
      "do": [
        {
          "modifyComponent": {
            "entity": { "var": "e" },
            "component": "Position",
            "values": {
              "x": {
                "+": [
                  { "getComponent": [{ "var": "e" }, "Position", "x"] },
                  { "getComponent": [{ "var": "e" }, "Velocity", "x"] }
                ]
              },
              "y": {
                "+": [
                  { "getComponent": [{ "var": "e" }, "Position", "y"] },
                  { "getComponent": [{ "var": "e" }, "Velocity", "y"] }
                ]
              }
            }
          }
        },
        {
          "modifyComponent": {
            "entity": { "var": "e" },
            "component": "Lifetime",
            "values": {
              "ticks": { "-": [{ "getComponent": [{ "var": "e" }, "Lifetime", "ticks"] }, 1] }
            }
          }
        }
      ]
    },
    {
      "name": "FireballImpact",
      "order": 50,
      "query": { "all": ["Position", "Lifetime"] },
      "as": "e",
      "do": [
        {
          "if": {
            "cond": { "<=": [{ "getComponent": [{ "var": "e" }, "Lifetime", "ticks"] }, 0] },
            "then": [
              {
                "let": {
                  "bindings": {
                    "at": {
                      "vec": [
                        { "getComponent": [{ "var": "e" }, "Position", "x"] },
                        { "getComponent": [{ "var": "e" }, "Position", "y"] }
                      ]
                    }
                  },
                  "do": [
                    { "carveFloor": { "at": { "var": "at" } } },
                    {
                      "emitEvent": {
                        "type": "FireballExploded",
                        "data": {
                          "x": { "vec.x": [{ "var": "at" }] },
                          "y": { "vec.y": [{ "var": "at" }] }
                        }
                      }
                    },
                    { "destroyEntity": { "entity": { "var": "e" } } }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FallStart",
      "order": 120,
      "do": [
        {
          "forEachEvent": {
            "type": "FellThroughFloor",
            "as": "ev",
            "do": [
              {
                "let": {
                  "bindings": { "e": { "eventField": [{ "var": "ev" }, "entity"] } },
                  "do": [
                    {
                      "addComponent": {
                        "entity": { "var": "e" },
                        "component": "Falling",
                        "values": { "progress": 0, "duration": 45 }
                      }
                    },
                    {
                      "modifyComponent": {
                        "entity": { "var": "e" },
                        "component": "Velocity",
                        "values": { "x": 0, "y": 0 }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FallProgress",
      "order": 121,
      "query": { "all": ["Falling"] },
      "as": "e",
      "do": [
        {
          "let": {
            "bindings": {
              "next": { "+": [{ "getComponent": [{ "var": "e" }, "Falling", "progress"] }, 1] }
            },
            "do": [
              {
                "modifyComponent": {
                  "entity": { "var": "e" },
                  "component": "Falling",
                  "values": { "progress": { "var": "next" } }
                }
              },
              {
                "if": {
                  "cond": {
                    ">=": [{ "var": "next" }, { "getComponent": [{ "var": "e" }, "Falling", "duration"] }]
                  },
                  "then": [
                    {
                      "emitEvent": {
                        "type": "EntityDied",
                        "data": { "entity": { "var": "e" } }
                      }
                    },
                    { "destroyEntity": { "entity": { "var": "e" } } }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
