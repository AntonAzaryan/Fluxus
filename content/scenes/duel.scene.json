    {
      "name": "DomeSlow",
      "order": 34,
      "query": { "all": ["DomeState", "Owner", "Position"] },
      "as": "d",
      "do": [
        {
          "let": {
            "bindings": {
              "center": {
                "vec": [
                  { "getComponent": [{ "var": "d" }, "Position", "x"] },
                  { "getComponent": [{ "var": "d" }, "Position", "y"] }
                ]
              },
              "mine": { "getComponent": [{ "var": "d" }, "Owner", "slot"] },
              "reach": { "getComponent": [{ "var": "d" }, "DomeState", "radius"] },
              "slot": { "+": [1000, { "getComponent": [{ "var": "d" }, "Owner", "slot"] }] },
              "slow": { "getComponent": [{ "var": "d" }, "DomeState", "slow"] }
            },
            "do": [
              {
                "forEach": {
                  "query": { "all": ["Owner", "TimeScaleModifiers"], "withTag": "Fireball" },
                  "as": "p",
                  "do": [
                    {
                      "removeModifier": {
                        "entity": { "var": "p" },
                        "component": "TimeScaleModifiers",
                        "id": { "var": "slot" }
                      }
                    }
                  ]
                }
              },
              {
                "forEach": {
                  "query": {
                    "all": ["Owner", "Position", "TimeScaleModifiers"],
                    "not": ["Held"],
                    "withTag": "Fireball",
                    "withinRadius": { "center": { "var": "center" }, "radius": { "var": "reach" } }
                  },
                  "as": "p",
                  "do": [
                    {
                      "if": {
                        "cond": {
                          "!=": [{ "getComponent": [{ "var": "p" }, "Owner", "slot"] }, { "var": "mine" }]
                        },
                        "then": [
                          {
                            "addModifier": {
                              "entity": { "var": "p" },
                              "component": "TimeScaleModifiers",
                              "id": { "var": "slot" },
                              "value": { "var": "slow" }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
