  "systems": [
    {
      "name": "KillSwitch",
      "order": 20,
      "query": { "all": ["Player", "Input", "Velocity"], "not": ["Dead"] },
      "as": "e",
      "do": [
        {
          "if": {
            "cond": {
              "and": [
                { "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "buttons"] }, 1] },
                { "!": [{ "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "prevButtons"] }, 1] }] }
              ]
            },
            "then": [
              {
                "addComponent": {
                  "entity": { "var": "e" },
                  "component": "Dead",
                  "values": { "atTick": { "tick": [] } }
                }
              },
              {
                "removeComponent": {
                  "entity": { "var": "e" },
                  "component": "Locomotion"
                }
              },
              {
                "modifyComponent": {
                  "entity": { "var": "e" },
                  "component": "Velocity",
                  "values": { "x": 0, "y": 0 }
                }
              },
              {
                "emitEvent": {
                  "type": "EntityDied",
                  "data": { "entity": { "var": "e" } }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Cast",
      "order": 30,
      "query": { "all": ["Input", "Player"], "not": ["Dead"] },
      "as": "e",
      "do": [
        {
          "if": {
            "cond": {
              "and": [
                { "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "buttons"] }, 0] },
                { "!": [{ "bitTest": [{ "getComponent": [{ "var": "e" }, "Input", "prevButtons"] }, 0] }] }
              ]
            },
            "then": [
              {
                "let": {
                  "bindings": {
                    "dir": {
                      "vec": [
                        { "cos": [{ "getComponent": [{ "var": "e" }, "Input", "aimDir"] }] },
                        { "sin": [{ "getComponent": [{ "var": "e" }, "Input", "aimDir"] }] }
                      ]
                    }
                  },
                  "do": [
                    {
                      "spawnEntity": {
                        "prefab": "Fireball",
                        "overrides": {
                          "Position": {
                            "x": {
                              "+": [
                                { "getComponent": [{ "var": "e" }, "Position", "x"] },
                                { "*": [{ "vec.x": [{ "var": "dir" }] }, 29491] }
                              ]
                            },
                            "y": {
                              "+": [
                                { "getComponent": [{ "var": "e" }, "Position", "y"] },
                                { "*": [{ "vec.y": [{ "var": "dir" }] }, 29491] }
                              ]
                            }
                          },
                          "Velocity": {
                            "x": { "*": [{ "vec.x": [{ "var": "dir" }] }, 16384] },
                            "y": { "*": [{ "vec.y": [{ "var": "dir" }] }, 16384] }
                          }
                        }
                      }
                    },
                    {
                      "emitEvent": {
                        "type": "CastFireball",
                        "data": {
                          "dirX": { "vec.x": [{ "var": "dir" }] },
                          "dirY": { "vec.y": [{ "var": "dir" }] },
                          "entity": { "var": "e" },
                          "slot": { "getComponent": [{ "var": "e" }, "Player", "slot"] },
                          "tick": { "tick": [] }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FireballFlight",
      "order": 40,
      "query": { "all": ["Position", "Velocity", "Lifetime"] },
      "as": "e",
      "do": [
        {
          "modifyComponent": {
            "entity": { "var": "e" },
            "component": "Lifetime",
            "values": {
              "ticks": { "-": [{ "getComponent": [{ "var": "e" }, "Lifetime", "ticks"] }, 1] }
            }
          }
        }
      ]
    },
    {
      "name": "FireballImpact",
      "order": 60,
      "query": { "all": ["Position", "Lifetime"] },
      "as": "e",
      "do": [
        {
          "if": {
            "cond": { "<=": [{ "getComponent": [{ "var": "e" }, "Lifetime", "ticks"] }, 0] },
            "then": [
              {
                "let": {
                  "bindings": {
                    "at": {
                      "vec": [
                        { "getComponent": [{ "var": "e" }, "Position", "x"] },
                        { "getComponent": [{ "var": "e" }, "Position", "y"] }
                      ]
                    }
                  },
                  "do": [
                    { "carveFloor": { "at": { "var": "at" } } },
                    {
                      "emitEvent": {
                        "type": "FireballExploded",
                        "data": {
                          "x": { "vec.x": [{ "var": "at" }] },
                          "y": { "vec.y": [{ "var": "at" }] }
                        }
                      }
                    },
                    { "destroyEntity": { "entity": { "var": "e" } } }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FallStart",
      "order": 120,
      "do": [
        {
          "forEachEvent": {
            "type": "FellThroughFloor",
            "as": "ev",
            "do": [
              {
                "let": {
                  "bindings": { "e": { "eventField": [{ "var": "ev" }, "entity"] } },
                  "do": [
                    {
                      "if": {
                        "cond": { "hasComponent": [{ "var": "e" }, "FallConfig"] },
                        "then": [
                          {
                            "addComponent": {
                              "entity": { "var": "e" },
                              "component": "Falling",
                              "values": { "depth": 0 }
                            }
                          },
                          {
                            "addComponent": {
                              "entity": { "var": "e" },
                              "component": "LevelOverride",
                              "values": { "level": 0 }
                            }
                          },
                          {
                            "removeComponent": {
                              "entity": { "var": "e" },
                              "component": "Locomotion"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "FallDeath",
      "order": 130,
      "query": { "all": ["Falling", "FallConfig"], "not": ["Dead"] },
      "as": "e",
      "do": [
        {
          "let": {
            "bindings": {
              "depth": {
                "+": [
                  { "getComponent": [{ "var": "e" }, "Falling", "depth"] },
                  { "getComponent": [{ "var": "e" }, "FallConfig", "speed"] }
                ]
              }
            },
            "do": [
              {
                "modifyComponent": {
                  "entity": { "var": "e" },
                  "component": "Falling",
                  "values": { "depth": { "var": "depth" } }
                }
              },
              {
                "if": {
                  "cond": {
                    ">=": [
                      { "var": "depth" },
                      { "getComponent": [{ "var": "e" }, "FallConfig", "deathDepth"] }
                    ]
                  },
                  "then": [
                    {
                      "addComponent": {
                        "entity": { "var": "e" },
                        "component": "Dead",
                        "values": { "atTick": { "tick": [] } }
                      }
                    },
                    {
                      "emitEvent": {
                        "type": "EntityDied",
                        "data": { "entity": { "var": "e" } }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
