                    "hold": { "getComponent": [{ "var": "e" }, "AbilityConfig", "holdTicks"] },
                    "mine": { "getComponent": [{ "var": "e" }, "Player", "slot"] },
                    "reach": { "getComponent": [{ "var": "e" }, "AbilityConfig", "captureRadius"] }
