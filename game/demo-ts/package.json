{
  "name": "@fluxus/demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "dev:tunnel": "vite --config app/vite.config.ts --mode tunnel",
    "demo:build": "vite build --config app/vite.config.ts",
    "demo:build:desktop": "vite build --config app/vite.desktop.config.ts",
    "demo:serve": "node bin/demo-serve.mjs",
    "bots:sync": "node bin/bots-sync.mjs",
    "bench:demo": "node bin/bench-demo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18 <23 || ^24 || >=26"
  },
  "dependencies": {
    "@fluxus/assets": "*",
    "@fluxus/bot": "*",
    "@fluxus/client": "*",
    "@fluxus/core": "*",
    "@fluxus/desktop-shell": "*",
    "@fluxus/hud": "*",
    "@fluxus/net": "*",
    "@fluxus/render": "*",
    "@fluxus/server-agent": "*",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.185.4",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
