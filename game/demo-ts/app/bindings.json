{
  "keyboardMouse": {
    "move": { "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" },
    "keys": {
      "ShiftLeft": "dodge",
      "ShiftRight": "dodge",
      "Space": "jump",
      "KeyK": "kill",
      "KeyF": "slowDome",
      "KeyR": "capture",
      "KeyE": "shield",
      "KeyX": "rewind",
      "KeyQ": "cancel"
    },
    "pointerButtons": { "0": "cast", "2": "confirm" }
  },
  "touch": {
    "moveStick": {
      "zone": { "left": 0, "top": 0.4, "width": 0.5, "height": 0.6 },
      "radius": 0.12
    },
    "aimStick": {
      "zone": { "left": 0.5, "top": 0.4, "width": 0.5, "height": 0.6 },
      "radius": 0.12,
      "releaseAction": "cast",
      "deadzone": 0.25
    },
    "buttons": [
      {
        "zone": { "left": 0.86, "top": 0.05, "width": 0.12, "height": 0.1 },
        "action": "jump"
      },
      {
        "zone": { "left": 0.72, "top": 0.05, "width": 0.12, "height": 0.1 },
        "action": "dodge"
      },
      {
        "zone": { "left": 0.86, "top": 0.17, "width": 0.12, "height": 0.1 },
        "action": "slowDome"
      },
      {
        "zone": { "left": 0.72, "top": 0.17, "width": 0.12, "height": 0.1 },
        "action": "capture"
      },
      {
        "zone": { "left": 0.86, "top": 0.29, "width": 0.12, "height": 0.1 },
        "action": "shield"
      },
      {
        "zone": { "left": 0.72, "top": 0.29, "width": 0.12, "height": 0.1 },
        "action": "rewind"
      },
      {
        "zone": { "left": 0.86, "top": 0.41, "width": 0.12, "height": 0.1 },
        "action": "confirm"
      },
      {
        "zone": { "left": 0.72, "top": 0.41, "width": 0.12, "height": 0.1 },
        "action": "cancel"
      }
    ]
  },
  "gamepad": {
    "moveAxes": [0, 1],
    "aimAxes": [2, 3],
    "deadzone": 0.25,
    "buttons": {
      "0": "jump",
      "1": "dodge",
      "2": "capture",
      "3": "slowDome",
      "4": "shield",
      "5": "cast",
      "6": "rewind",
      "7": "confirm",
      "8": "kill",
      "9": "cancel"
    }
  }
}
