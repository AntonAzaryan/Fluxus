{
  "keyboardMouse": {
    "move": { "up": "KeyW", "down": "KeyS", "left": "KeyA", "right": "KeyD" },
    "keys": {
      "ShiftLeft": "dodge",
      "ShiftRight": "dodge",
      "Space": "jump",
      "KeyK": "kill",
      "KeyF": "slowDome",
      "KeyR": "capture"
    },
    "pointerButtons": { "0": "cast" }
  },
  "touch": {
    "moveStick": {
      "zone": { "left": 0, "top": 0.4, "width": 0.5, "height": 0.6 },
      "radius": 0.12
    },
    "aimStick": {
      "zone": { "left": 0.5, "top": 0.4, "width": 0.5, "height": 0.6 },
      "radius": 0.12,
      "releaseAction": "cast",
      "deadzone": 0.25
    },
    "buttons": [
      { "zone": { "left": 0.86, "top": 0.05, "width": 0.12, "height": 0.1 }, "action": "jump" },
      { "zone": { "left": 0.72, "top": 0.05, "width": 0.12, "height": 0.1 }, "action": "dodge" },
      { "zone": { "left": 0.86, "top": 0.17, "width": 0.12, "height": 0.1 }, "action": "slowDome" },
      { "zone": { "left": 0.72, "top": 0.17, "width": 0.12, "height": 0.1 }, "action": "capture" }
    ]
  },
  "gamepad": {
    "moveAxes": [0, 1],
    "aimAxes": [2, 3],
    "deadzone": 0.25,
    "buttons": { "0": "jump", "1": "dodge", "2": "capture", "3": "slowDome", "5": "cast", "8": "kill" }
  }
}
