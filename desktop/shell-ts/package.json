{
  "name": "@game-mvp/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./bridge": "./src/bridge/index.ts",
    "./host": "./src/host/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "start:editor": "electron src/electron/entry.mjs --app apps/editor.app.json",
    "start:game": "electron src/electron/entry.mjs --app apps/game.app.json",
    "smoke": "node bin/smoke.mjs",
    "pack": "node bin/pack.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
