{
  "name": "game-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine/core-ts",
    "engine/net-ts",
    "engine/render-ts",
    "engine/assets-ts",
    "engine/client-ts",
    "engine/hud-ts",
    "engine/bot-ts",
    "engine/integration-ts",
    "editor/core-ts",
    "editor/ui-ts",
    "game/demo-ts",
    "tools/blender-ts",
    "desktop/shell-ts"
  ],
  "scripts": {
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "import": "node tools/blender-ts/bin/import.mjs",
    "demo": "npm run dev -w @game-mvp/demo",
    "demo:serve": "node game/demo-ts/bin/demo-serve.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:dead": "knip",
    "lint:dup": "jscpd .",
    "lint:arch": "depcruise engine editor game tools desktop scripts",
    "lint:all": "npm run typecheck && npm run lint && npm run lint:dead && npm run lint:dup && npm run lint:arch",
    "check": "npm run lint:all && npm run spec-graph -- check && npm test",
    "golden": "npm run record -w @game-mvp/integration && npm run golden -w @game-mvp/core",
    "spec-graph": "node scripts/spec-graph.mjs"
  },
  "engines": {
    "node": ">=22.18 <23 || ^24 || >=26"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "quarks.core": "0.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.5.0",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
