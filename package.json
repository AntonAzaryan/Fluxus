{
  "name": "fluxus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine/core-ts",
    "engine/net-ts",
    "engine/render-ts",
    "engine/assets-ts",
    "engine/client-ts",
    "engine/hud-ts",
    "engine/bot-ts",
    "engine/integration-ts",
    "editor/core-ts",
    "editor/ui-ts",
    "game/demo-ts",
    "game/server-agent-ts",
    "game/server-manager-ts",
    "tools/blender-ts",
    "desktop/shell-ts"
  ],
  "scripts": {
    "test": "vitest run --config vitest.gate.config.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "import": "node tools/blender-ts/bin/import.mjs",
    "sim": "node engine/core-ts/bin/sim.mjs",
    "journal": "node engine/core-ts/bin/journal.mjs",
    "demo": "npm run dev -w @fluxus/demo",
    "demo:lan": "npm run dev -w @fluxus/demo -- --host",
    "demo:tunnel": "npm run dev:tunnel -w @fluxus/demo",
    "demo:serve": "node game/demo-ts/bin/demo-serve.mjs",
    "demo:debug": "node game/demo-ts/bin/demo-serve.mjs --debug",
    "agent": "node game/server-agent-ts/bin/agent.mjs",
    "agent:pair": "node game/server-agent-ts/bin/agent.mjs pair",
    "host:bundle": "node game/server-agent-ts/bin/bundle.mjs",
    "manager": "npm run dev -w @fluxus/server-manager",
    "textures:water": "node scripts/gen-water-textures.mjs",
    "bots:sync": "node game/demo-ts/bin/bots-sync.mjs",
    "bench:demo": "npm run bench:demo -w @fluxus/demo --",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:dead": "knip",
    "lint:dup": "jscpd .",
    "lint:arch": "depcruise engine editor game tools desktop scripts",
    "lint:all": "npm run typecheck && npm run lint && npm run lint:dead && npm run lint:dup && npm run lint:arch",
    "check": "npm run lint:all && npm run spec-graph -- check && npm test",
    "check:impact": "node scripts/impact.mjs",
    "check:timings": "node scripts/impact.mjs --full --timings",
    "golden": "npm run record -w @fluxus/integration && npm run golden -w @fluxus/core",
    "golden:cost": "npm run golden:cost -w @fluxus/integration",
    "spec-graph": "node scripts/spec-graph.mjs"
  },
  "engines": {
    "node": ">=22.18 <23 || ^24 || >=26"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "quarks.core": "0.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.5.0",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
